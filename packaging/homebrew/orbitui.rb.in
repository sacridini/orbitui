# Generated by the orbitui release workflow from packaging/homebrew/orbitui.rb.in.
class Orbitui < Formula
  desc "Terminal planner of Earth observation satellite overpasses"
  homepage "https://github.com/sacridini/orbitui"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/sacridini/orbitui/releases/download/v@VERSION@/orbitui-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/sacridini/orbitui/releases/download/v@VERSION@/orbitui-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/sacridini/orbitui/releases/download/v@VERSION@/orbitui-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_aarch64-unknown-linux-musl@"
    end
    on_intel do
      url "https://github.com/sacridini/orbitui/releases/download/v@VERSION@/orbitui-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_x86_64-unknown-linux-musl@"
    end
  end

  def install
    bin.install "orbitui"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/orbitui --version")
  end
end
